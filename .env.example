# Ollama Framework — единая оболочка Ollama для ERGO MS
# При setup-full создаётся modules/ollama_framework/.env из этого файла.
# Переменные переопределяют одноимённые из корневого .env (если заданы).

# URL сервера Ollama (клиент). Serve по умолчанию слушает только 127.0.0.1.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Bind serve. Не задано — 127.0.0.1:11434. LAN только явно:
# OLLAMA_HOST=0.0.0.0:11434
OLLAMA_DEFAULT_MODEL=mistral:latest
OLLAMA_EMBEDDINGS_MODEL=embeddinggemma

# Локальный режим: 1 — без ollama.com / cloud models / web search (по умолчанию).
# Достаточно этой переменной; server.json не используем.
# OLLAMA_NO_CLOUD=0 — разрешить cloud-фичи Ollama
OLLAMA_NO_CLOUD=1

OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_STREAM_TIMEOUT=300
OLLAMA_CONCURRENCY_LIMIT=8
OLLAMA_MAX_RETRIES=2
OLLAMA_KEEP_ALIVE=10m

# Устройство inference: auto (по умолчанию — Ollama сам выбирает GPU/CPU), gpu или cpu.
# Переопределяется в config вызова (compute_device / num_gpu) или в .env потребителя.
OLLAMA_COMPUTE_DEVICE=auto

# Транспорт для потребителей этого модуля
# local — ModuleBridge in-process; http — REST API ollama_framework
OLLAMA_FRAMEWORK_TRANSPORT=local
# Базовый URL API ERGO MS (только для http), например http://127.0.0.1:8000/api/
OLLAMA_FRAMEWORK_API_BASE=
